# ==============================================================================
# AKSAVENTRA CBT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Provider Mode: "mariadb" atau "postgresql"
# Pilihan: mariadb | postgresql
DATABASE_PROVIDER="mariadb"

# ------------------------------------------------------------------------------
# 1. KONFIGURASI KONEKSI MARIADB / MYSQL (Default Mode)
# ------------------------------------------------------------------------------
# Format URL: mysql://<user>:<password>@<host>:<port>/<database>
# Port default MariaDB: 3306
DATABASE_URL="mysql://root:@localhost:3306/aksaventra_cbt"

# ------------------------------------------------------------------------------
# 2. KONFIGURASI KONEKSI POSTGRESQL (Alternatif)
# ------------------------------------------------------------------------------
# Jika ingin beralih ke PostgreSQL, aktifkan baris di bawah dan jalankan:
# `npm run db:mode:pg`
#
# DATABASE_PROVIDER="postgresql"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aksaventra_cbt?schema=public"

# ------------------------------------------------------------------------------
# AUTENTIKASI & KEAMANAN
# ------------------------------------------------------------------------------
# Secret key untuk penandatanganan JWT sesi CBT
CBT_JWT_SECRET="aksaventra-cbt-super-secure-jwt-secret-key-2026"

# ------------------------------------------------------------------------------
# LINGKUNGAN APLIKASI
# Pilihan: development | test | production
# ------------------------------------------------------------------------------
NODE_ENV="development"
