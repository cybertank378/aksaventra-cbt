# ==============================================================================
# AKSAVENTRA CBT - ENVIRONMENT CONFIGURATION (EXAMPLE ONLY)
# Salin berkas ini menjadi .env lalu isi dengan nilai kredensial yang valid.
# Jangan pernah meng-commit .env atau secret produksi ke Git.
# ==============================================================================

# Database Provider Mode: "mariadb" atau "postgresql"
DATABASE_PROVIDER="mariadb"

# ------------------------------------------------------------------------------
# 1. KONEKSI MARIADB / MYSQL (Default)
# Format: mysql://<user>:<password>@<host>:<port>/<database>
# ------------------------------------------------------------------------------
DATABASE_URL="mysql://cbt_user:CHANGE_ME_DB_PASSWORD@localhost:3306/aksaventra_cbt"

# ------------------------------------------------------------------------------
# 2. KONEKSI POSTGRESQL (Alternatif: jalankan `npm run db:mode:pg`)
# ------------------------------------------------------------------------------
# DATABASE_PROVIDER="postgresql"
# DATABASE_URL="postgresql://postgres:CHANGE_ME_DB_PASSWORD@localhost:5432/aksaventra_cbt?schema=public"

# ------------------------------------------------------------------------------
# AUTENTIKASI & KEAMANAN (WAJIB DI PRODUKSI)
# Gunakan string acak minimal 32 karakter (contoh: `openssl rand -base64 32`)
# ------------------------------------------------------------------------------
CBT_JWT_SECRET="CHANGE_ME_GENERATE_RANDOM_32_CHAR_SECRET"

# ------------------------------------------------------------------------------
# INTEGRASI MOODLE LMS (mod_cbt)
# ------------------------------------------------------------------------------
MOODLE_URL="https://moodle.example.sch.id"
MOODLE_WS_TOKEN="CHANGE_ME_MOODLE_WEBSERVICE_TOKEN"
MOODLE_WEBHOOK_SECRET="CHANGE_ME_MOODLE_WEBHOOK_SECRET"

# URL publik aplikasi CBT (opsional, untuk tautan eksternal/manifest)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# LINGKUNGAN APLIKASI: development | test | production
# ------------------------------------------------------------------------------
NODE_ENV="development"
